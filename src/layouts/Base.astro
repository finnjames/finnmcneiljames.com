---
import '../styles/global.scss';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  /** Shown before the site name in the tab title. */
  title?: string;
  description?: string;
  footer?: boolean;
  /** Whether the page sets anything in the title face on arrival, and so should fetch it early. */
  titleFont?: boolean;
}

const {
  title,
  description = 'I’m Finn, a software engineer & artist.',
  footer = true,
  titleFont = true,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title ? `${title} — Finn James` : 'Finn James'}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=SUSE:ital,wght@0,100..800;1,100..800&family=SUSE+Mono:ital,wght@0,100..800;1,100..800&display=swap"
    />
    {titleFont && (
      <link rel="preload" href="/fonts/OB-sys12-VF.woff2" as="font" type="font/woff2" crossorigin />
    )}
    <slot name="head" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-XRLEG6433K"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());

      gtag('config', 'G-XRLEG6433K');
    </script>
    <!-- runs before the first paint, so the page never flashes the wrong color mode -->
    <script is:inline>
      (function () {
        function getInitialColorMode() {
          try {
            var persistedColorMode = window.localStorage.getItem('color-mode');
            if (persistedColorMode === 'dark' || persistedColorMode === 'light')
              return persistedColorMode;
            if (window.matchMedia('(prefers-color-scheme: dark)').matches) return 'dark';
          } catch (e) {}
          return 'light';
        }
        var colorMode = getInitialColorMode();
        document.documentElement.setAttribute('data-color-mode', colorMode);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link label" href="#main">
      Skip to content
    </a>
    <div class="container">
      <Header />
      <main id="main">
        <div class="content-area">
          <slot />
        </div>
        {footer && <Footer />}
      </main>
    </div>
  </body>
</html>

<style lang="scss">
  /* out of sight until it is reached with the keyboard, then it drops in over the header */
  .skip-link {
    position: fixed;
    top: 0.6rem;
    left: var(--gutter);
    z-index: 20;
    padding: 0.8rem 1.2rem;
    border-radius: 1.6rem;
    background: var(--fg);
    color: var(--bg);
    text-decoration: none;
    translate: 0 calc(-100% - 1.2rem);

    &:focus {
      translate: none;
    }
  }

  .container {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  main {
    flex: 1 0 auto;
    display: flex;
    flex-direction: column;
  }

  .content-area {
    flex: 1 0 auto;
  }
</style>
